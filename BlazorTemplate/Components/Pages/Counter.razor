@page "/counter/{CurrentCount?}" 
@using System.Runtime.CompilerServices
@*einbindung von parametern die man über die URL weitergeben kann an die Komponente WICHTIG: wird immer als String angesehen*@
@* CurrentCount? das ? macht das der Parameter Optional ist*@
@* Die Paramter können auch als HTML attribut angesprochen werden *@
@* damit mann den Parameter nicht parsen muss kann man auch direct einen RouteConstraint machen
    z.B: @page "/counter/{CurrentCount:int?}" *@
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin, Customer, Guest")]

<PageTitle>Counter</PageTitle>

<h1>Counter</h1>

<p role="status">Current count: @currentCount</p>

<button class="btn btn-primary" @onclick="IncrementCount">Click me</button>
<BlazorTemplate.Components.BlzrTutorial.MyButton OnClick="IncrementCount" class="btn btn-success">test</BlazorTemplate.Components.BlzrTutorial.MyButton>


<div class="mt-3">
    <input @bind="text" @bind:event="oninput" @bind:after="Search">
    @* Bind setzt ein 2way binding für das feld fest welches immer auf OnChange triggert.
    Wenn man das ändern möchte kann man den @BInd:event Attribut nutzen um das event zu ändern welches feuert wenn das gebindete feld bearbeitet wird. *@
    <button @onclick="OnClick">clear</button>
    <p>@text</p>
    <p>@SearchResult</p>
</div>

@if(increment > 1){
    <ul>
        @for(int i = 0; i < currentCount; i++)
        {
            <li>Clicked!</li>
        }
    </ul>
}

@code {
    [Parameter]
    public string CurrentCount {
        get{return currentCount.ToString();}
        set{if(int.TryParse(value,out int number))
                currentCount = number;
            else 
                currentCount = 0;}
    }
    private int currentCount = 0;

    [Parameter]
    public int increment {get; set;} = 1;


    private void IncrementCount()
    {
        currentCount += increment;
    }

    string SearchResult = "";
    string text = "";
    private void OnClick(MouseEventArgs args)
    {
        text = "";
    }
    async Task Search()
    {
       SearchResult = "Searching.....";
       await Task.Delay(2000);
       SearchResult = $"Found {Random.Shared.Next()} results!";
    }
}

@* 
als komponente verwenden z.B: 

@{
    var amount = 2;
}

<Counter increment="amount" CurrentCount="420"/>
 *@
