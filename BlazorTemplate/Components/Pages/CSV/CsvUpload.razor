@page "/csv-upload"
@using CsvHelper
@using System.Globalization
@using Microsoft.AspNetCore.Components.Forms
@attribute [StreamRendering]
@attribute [Authorize(Roles = "Admin, User, Guest")]

<h3>CSV Upload</h3>

<InputFile OnChange="HandleFileSelected" accept=".csv" />

@if (records != null && records.Any())
{
    <table class="table table-striped mt-3">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Created</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in records)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>@item.Created.ToString("yyyy-MM-dd")</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-muted">Noch keine CSV geladen.</p>
}

@code {
    private List<MyModel> records = new();

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;

        var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024); // 10 MB
        using var reader = new StreamReader(stream);
        using var csv = new CsvReader(reader, new CsvHelper.Configuration.CsvConfiguration(CultureInfo.InvariantCulture)
        {
            Delimiter = ";"
        });


        // CSV -> Objekte
        records = csv.GetRecords<MyModel>().ToList();
    }

    // Beispielmodell (muss zu deiner CSV passen)
    public class MyModel
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public DateTime Created { get; set; }
    }
}
