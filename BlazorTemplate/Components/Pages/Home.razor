@page "/"
@using DB_Models.DTO
@using Microsoft.AspNetCore.Components.Forms
@inject BLDAL.UnitOfWork uow

<PageTitle>Home</PageTitle>
<div class="full-background">

<div class="hero-section">

    <div class="hero-overlay">

        <h1 class="hero-title">
            Willkommen im Köö Bludenz
        </h1>

        <p class="hero-subtitle">
            Wir veranstalten ein Turnier am xx.xx.xxxx. <br/>
            Jetzt anmelden!
        </p>

        <EditForm EditContext="@editContext" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="form-group">
                <label for="name">Name</label>
                <InputText id="name" class="form-control" @bind-Value="anmeldung.Name" />
                <ValidationMessage For="() => anmeldung.Name" />
            </div>

            <div class="form-group">
                <label for="email">E-Mail</label>
                <InputText id="email" class="form-control" @bind-Value="anmeldung.Email" />
                <ValidationMessage For="() => anmeldung.Email" />
            </div>

            <div class="form-group">
                <label for="phone">Telefon</label>
                <InputText id="phone" class="form-control" @bind-Value="anmeldung.PhoneNumber" />
                <ValidationMessage For="() => anmeldung.PhoneNumber" />
            </div>

            <button type="submit" class="form-button">
                Jetzt anmelden
            </button>

        </EditForm>

    </div>

</div>

</div>

@code {
    private TRegisterDTO anmeldung = new();
    private EditContext editContext;

    protected override void OnInitialized()
    {
        editContext = new EditContext(anmeldung);
    }

    private async Task HandleSubmit()
    {
        Console.WriteLine($"Anmeldung: {anmeldung.Name}");

        try
        {
            // Persist the registration using UnitOfWork
            // Example (implement a proper repo and method first):
            // uow.RegistrationRepo.Add(new Registration { Name = anmeldung.Name, Email = anmeldung.Email, Phone = anmeldung.PhoneNumber });
            // uow.Commit();

            // If you don't have a RegistrationRepo yet, add one in BLDAL and expose it via UnitOfWork,
            // similar to how Userrepo, TodoRepo or RankingRepo are exposed.
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving registration: {ex.Message}");
        }

        // Reset form + validation state
        anmeldung = new TRegisterDTO();
        editContext = new EditContext(anmeldung);
        await InvokeAsync(StateHasChanged);
    }
}