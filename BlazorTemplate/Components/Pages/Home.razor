@page "/"
@attribute [AllowAnonymous]

<PageTitle>Köö Bludenz</PageTitle>

<section class="landing-shell">
    <div class="landing-card">
        <p class="kicker">Billiard Club</p>
        <h1>Willkommen im Köö Bludenz</h1>
        <p class="lead">
            Bar, Turniere und Vereinsleben an einem Ort. Melde dich fuer das naechste Turnier an
