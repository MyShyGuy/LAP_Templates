@page "/"

<PageTitle>Home</PageTitle>
<div class="full-background">

<div class="hero-section">

    <div class="hero-overlay">

        <h1 class="hero-title">
            Willkommen im Köö Bludenz
        </h1>

        <p class="hero-subtitle">
            Wir veranstalten ein Turnier am xx.xx.xxxx. <br/>
            Jetzt anmelden!
        </p>

        <EditForm Model="anmeldung" OnValidSubmit="HandleSubmit">

            <div class="form-group">
                <label>Name</label>
                <InputText @bind-Value="anmeldung.Name" />
            </div>

            <div class="form-group">
                <label>E-Mail</label>
                <InputText @bind-Value="anmeldung.Email" />
            </div>

            <div class="form-group">
                <label>Telefon</label>
                <InputText @bind-Value="anmeldung.Telefon"  />
            </div>

            <button type="submit" class="form-button">
                Jetzt anmelden
            </button>

        </EditForm>

    </div>

</div>


</div>

@code {

    Anmeldung anmeldung = new();

    void HandleSubmit()
    {
        Console.WriteLine($"Anmeldung: {anmeldung.Name}");
    }

    class Anmeldung
    {
        public string? Name { get; set; }
        public string? Email { get; set; }
        public string? Telefon { get; set; }
    }

}