@page "/todo"
@using DB_Models.DTO
@using System.Security.Claims
@using DB_Models.Models
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin, User, Guest")]
@inject BLDAL.UnitOfWork uow;
@inject AuthenticationStateProvider AuthStateProvider


<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10 col-sm-12 text-center">
            <h1>My ToDo List:</h1>

            <!-- Header für Grid -->
            <div class="row fw-bold border-bottom py-2">
                <div class="col-1">Done</div>
                <div class="col-3">Titel</div>
                <div class="col-5">Beschreibung</div>
                <div class="col-3">Aktion</div>
            </div>

            <!-- Todos im Grid -->
            @foreach (var todo in todos)
            {
                <div class="row align-items-center py-2 border-bottom">
                    <div class="col-1">
                        <input type="checkbox" @bind="todo.IsDone" />
                    </div>
                    <div class="col-3">
                        <input class="form-control" @bind="todo.Title" />
                    </div>
                    <div class="col-5">
                        <input class="form-control" @bind="todo.Description" />
                    </div>
                    <div class="col-3">
                        <button class="btn btn-sm btn-danger" @onclick="() => RemoveSingle(todo)">X</button>
                    </div>
                </div>
            }

            <!-- Footer -->
            <h3 class="mt-3">
                Need to Finish: @todos.Count(x => !x.IsDone)
            </h3>
            <EditForm Model="@newtodo" OnValidSubmit="@AddTodo" FormName="TodoForm">
                 <DataAnnotationsValidator />
                <div class="row g-2 mt-2">
                    <div class="col-8">
                        <InputText class="form-control" placeholder="Neues Todo..." @bind-Value="newtodo.Title"/>
                        <ValidationMessage For="() => newtodo.Title"/>
                    </div>
                    <div class="col-2">
                        <button type="submit" class="btn btn-primary w-100">Add</button>
                    </div>
                    <div class="col-2">
                        <button class="btn btn-secondary w-100" @onclick="removeFinishedTodos">Remove Done</button>
                    </div>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    private ClaimsPrincipal? user;
    private User? usr;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        user = authState.User;
        string userName = user.Identity.Name.ToString();
        usr = uow.Userrepo.GetUser(userName);
    }
    
    public List<TodoDTO> todos = new List<TodoDTO>();
    public TodoDTO newtodo {get; set;} = new TodoDTO();

    private void AddTodo()
    {
        if (!string.IsNullOrWhiteSpace(newtodo.Title))
        {
            newtodo.User = usr;
            newtodo.CreatedAt = DateTime.Now;
            todos.Add(newtodo);
        }     
        newtodo = new TodoDTO();
    }

    private void RemoveSingle(TodoDTO todo)
    {
        todos.Remove(todo);
    }

    private async Task removeFinishedTodos()
    {
        todos.RemoveAll(t => t.IsDone);
    }
}
